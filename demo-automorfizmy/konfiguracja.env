# Konfiguracja eksperymentu. Każdą wartość można nadpisać zmienną środowiskową,
# np.  CZAS_CALKOWITY_MIN=60 ./run.sh

# --- tryb ---
: "${TRYB:=proba}"                # proba = bez pusha, PDF z etykietą PRÓBA; wyklad = publikacja

# --- czas (minuty); przy 38 min wychodzą 2 iteracje wykonawców ---
: "${CZAS_CALKOWITY_MIN:=38}"     # od startu do gotowego raportu końcowego
: "${LIMIT_PLANISTY_MIN:=4}"   # 3 min nie wystarczyło (próba 2)
: "${LIMIT_WYKONAWCY_MIN:=12}"    # górny limit jednej iteracji wykonawców
: "${MIN_WYKONAWCY_MIN:=5}"       # krótszej iteracji już nie zaczynamy
: "${REDAKCJA_POSREDNIA:=0}"      # 1 = redaktor także po każdej iteracji (kosztuje czas)
: "${LIMIT_REDAKTORA_MIN:=4}"     # redakcja pośrednia
: "${REZERWA_KONCOWA_MIN:=5}"     # redakcja końcowa, kompilacja, publikacja
: "${MAKS_WYKONAWCOW:=3}"         # równoległych agentów-wykonawców

# --- model ---
: "${CLAUDE_BIN:=claude}"
: "${MODEL:=opus}"
: "${WYSILEK_PLANISTY:=medium}"    # low|medium|high|xhigh|max
: "${WYSILEK_WYKONAWCY:=medium}"
: "${WYSILEK_REDAKTORA:=low}"

# --- środowisko (mamba env create -f environment.yml) ---
: "${SRODOWISKO:=demo-automorfizmy}"   # nazwa środowiska; ENV_PREFIX można podać wprost
if [ -z "${ENV_PREFIX:-}" ]; then
  ENV_PREFIX=$({ mamba env list 2>/dev/null || conda env list 2>/dev/null; } \
    | awk -v n="$SRODOWISKO" '$1 == n {print $NF; exit}')
fi
[ -n "$ENV_PREFIX" ] && PATH="$ENV_PREFIX/bin:$PATH"   # sage, Singular, python, jq, gh
: "${PYTHON:=${ENV_PREFIX:+$ENV_PREFIX/bin/}python3}"
: "${DODATKOWY_PATH:=}"           # dodatkowe katalogi z programami dla agentów (np. M2, magma)
: "${KONSTRUKCJA_BAZOWA:=1}"      # 1 = etap 0 liczy znaną konstrukcję (m-1)^2 bez agentów
: "${WSKAZOWKI:=0}"               # 1 = agenci dostają wskazowki_opcjonalne.md

# --- publikacja ---
: "${GH_REPO:=rodakt/demo-automorfizmy}"  # repo wykładu (start.sh test/proba go nie używa); puste = bez GitHuba
: "${GH_WIDOCZNOSC:=public}"      # private|public (na starcie; zmiana: gh repo edit)
: "${PUSH_PO_ETAPIE:=1}"          # 1 = push po każdym etapie (podgląd na żywo)
: "${AUTOR:=Tomasz Rodak}"        # nazwisko w raporcie

[ -n "$DODATKOWY_PATH" ] && PATH="$DODATKOWY_PATH:$PATH"
export PYTHON AUTOR PATH ENV_PREFIX
